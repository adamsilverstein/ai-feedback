	"_comment_blocks": "Blocks with inner blocks: the editor matches an edit against the block's own rich text, `content`, never the inner blocks. The server reads it from the innerContent strings around the inner blocks (before, inner, after); the review reads the `content` attribute.",
	"blocks": [
		{
			"name": "list item with a nested list",
			"block": "core/list-item",
			"before": "<li>Revenue grew 40%<br>last year.",
			"inner": "<ul class=\"wp-block-list\"><li>Nested item</li></ul>",
			"after": "</li>",
			"content": "Revenue grew 40%<br>last year.",
			"text": "Revenue grew 40%\nlast year."
		},
		{
			"name": "list item with a nested list and two spaces",
			"block": "core/list-item",
			"before": "<li>Two.&nbsp; Spaces",
			"inner": "<ul class=\"wp-block-list\"><li>Nested item</li></ul>",
			"after": "</li>",
			"content": "Two.&nbsp; Spaces",
			"text": "Two.\u00a0 Spaces"
		}
	],
	"_comment_targets": "Serialized blocks and the text a move keeps when it targets them: the block's own text without its inner blocks, whitespace collapsed and inline images left out. Reply_Service::target_text() and getOwnBlockTexts() in src/utils/block-action.js must agree with it.",
	"targets": [
		{
			"name": "paragraph",
			"markup": "<!-- wp:paragraph --><p>Plain <strong>text</strong> here.</p><!-- /wp:paragraph -->",
			"text": "Plain text here."
		},
		{
			"name": "paragraph with a line break",
			"markup": "<!-- wp:paragraph --><p>Revenue grew<br>last year.</p><!-- /wp:paragraph -->",
			"text": "Revenue grew last year."
		},
		{
			"name": "quote with a citation",
			"markup": "<!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>Inner words.</p><!-- /wp:paragraph --><cite>Ada Lovelace</cite></blockquote><!-- /wp:quote -->",
			"text": "Ada Lovelace"
		},
		{
			"name": "list item with a nested list",
			"markup": "<!-- wp:list-item --><li>Parent item<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Nested item</li><!-- /wp:list-item --></ul><!-- /wp:list --></li><!-- /wp:list-item -->",
			"text": "Parent item"
		},
		{
