parameters:
    level: 5
    paths:
        - includes/
        - copydesk-ai.php
    scanFiles:
        - copydesk-ai.php
    bootstrapFiles:
        - phpstan-stubs.php
    excludePaths:
        - vendor/ (?)
        - node_modules/ (?)
    ignoreErrors:
        - '#Constant [A-Z_]+ not found\.#'
        -
            message: '#If condition is always false\.#'
            path: copydesk-ai.php
        -
            message: '#Right side of && is always false\.#'
            paths:
                - includes/class-review-service.php
                - includes/class-reply-service.php
